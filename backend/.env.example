# Copy to .env and fill in. Never commit .env.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3001
# Local timezone used for "today" (checkout reminders, bill reminders, bonus due dates, default payment dates)
TZ=Asia/Colombo
# Set on the server by deploy.sh; blocks the dev-only test-data scripts
# NODE_ENV=production
