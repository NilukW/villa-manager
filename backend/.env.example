# Copy to .env and fill in. Never commit .env.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3001
# Local timezone used for "today" (checkout reminders, bill reminders, bonus due dates, default payment dates)
TZ=Asia/Colombo
# Optional: lets the app read uploaded grocery bills (photo/PDF) with Claude and fill in the items.
# Get a key at https://console.anthropic.com. Bill images are sent to Anthropic's API for reading.
ANTHROPIC_API_KEY=
# Set on the server by deploy.sh; blocks the dev-only test-data scripts
# NODE_ENV=production
